<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.school.controller.LoginController"
           stylesheets="@../css/styles.css"
           styleClass="login-bg">

    <VBox alignment="CENTER" spacing="28" maxWidth="400">

        <!-- Logo / Title -->
        <VBox alignment="CENTER" spacing="6">
            <Label text="🏫" style="-fx-font-size: 52px;"/>
            <Label text="School Management System"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Label text="Sign in to your account"
                   style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
        </VBox>

        <!-- Card -->
        <VBox styleClass="login-card" spacing="18">
            <padding><Insets top="32" right="36" bottom="32" left="36"/></padding>

            <!-- Error message -->
            <Label fx:id="errorLabel"
                   styleClass="error-label"
                   wrapText="true"
                   visible="false" managed="false"/>

            <!-- Username -->
            <VBox spacing="6">
                <Label text="Username" styleClass="field-label"/>
                <TextField fx:id="usernameField"
                           promptText="Enter your username"
                           styleClass="input-field"
                           onAction="#handleLogin"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="6">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               styleClass="input-field"
                               onAction="#handleLogin"/>
            </VBox>

            <!-- Login button -->
            <Button fx:id="loginButton"
                    text="Sign In"
                    styleClass="btn-primary"
                    maxWidth="Infinity"
                    onAction="#handleLogin"/>
        </VBox>

    </VBox>
</StackPane>