<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
  fees.fxml
  Path: src/main/resources/com/school/fxml/views/fees.fxml
  Used by Staff and Principal.
-->
<BorderPane
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.school.controller.FeesController"
        stylesheets="@../../css/styles.css">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT">
                <padding><Insets top="20" right="24" bottom="12" left="24"/></padding>
                <Label text="Fee Management" styleClass="page-title"/>
            </HBox>
            <Separator/>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>

            <!-- ══ Tab 1: Fee Structures ══════════════════════════ -->
            <Tab text="🗂  Fee Structures">
                <SplitPane orientation="VERTICAL" dividerPositions="0.55">

                    <!-- Top: structure list -->
                    <VBox spacing="10">
                        <padding><Insets top="14" right="16" bottom="8" left="16"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Filter by Term:" styleClass="form-label"/>
                            <ComboBox fx:id="structureTermFilter" prefWidth="180" promptText="All terms"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="＋  Add Structure"
                                    styleClass="btn-primary"
                                    onAction="#handleAddStructure"/>
                        </HBox>

                        <TableView fx:id="structureTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                            <placeholder><Label text="No fee structures found."/></placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="fsColGrade"   text="Grade"       maxWidth="90"  minWidth="70"/>
                                <TableColumn fx:id="fsColTerm"    text="Term"        maxWidth="100" minWidth="80"/>
                                <TableColumn fx:id="fsColYear"    text="Year"        maxWidth="120" minWidth="100"/>
                                <TableColumn fx:id="fsColDesc"    text="Description" minWidth="180"/>
                                <TableColumn fx:id="fsColTotal"   text="Total (LKR)" maxWidth="130" minWidth="110"/>
                                <TableColumn fx:id="fsColActions" text="Actions"     maxWidth="200" minWidth="180"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Bottom: fee items for selected structure -->
                    <VBox spacing="10">
                        <padding><Insets top="10" right="16" bottom="14" left="16"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="itemsTitle"
                                   text="Fee Items — select a structure above"
                                   styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnAddItem"
                                    text="＋  Add Item"
                                    styleClass="btn-secondary"
                                    onAction="#handleAddItem"
                                    disable="true"/>
                        </HBox>
                        <TableView fx:id="itemsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                            <placeholder><Label text="Select a fee structure above to view its items."/></placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="fiColName"    text="Item Name"   minWidth="200"/>
                                <TableColumn fx:id="fiColAmount"  text="Amount (LKR)" maxWidth="150" minWidth="120"/>
                                <TableColumn fx:id="fiColActions" text="Actions"     maxWidth="180" minWidth="160"/>
                            </columns>
                        </TableView>
                    </VBox>

                </SplitPane>
            </Tab>

            <!-- ══ Tab 2: Invoices ════════════════════════════════ -->
            <Tab text="📒  Invoices">
                <SplitPane orientation="VERTICAL" dividerPositions="0.60">

                    <!-- Top: invoice list + filters -->
                    <VBox spacing="10">
                        <padding><Insets top="14" right="16" bottom="8" left="16"/></padding>

                        <!-- Filter row -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <TextField fx:id="invoiceSearchField"
                                       promptText="Search student name…"
                                       prefWidth="220"
                                       onKeyReleased="#handleInvoiceSearch"/>
                            <Label text="Status:" styleClass="form-label"/>
                            <ComboBox fx:id="statusFilter" prefWidth="130" promptText="All"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Generate Invoices"
                                    styleClass="btn-secondary"
                                    onAction="#handleGenerateInvoices"/>
                        </HBox>

                        <!-- Summary badges -->
                        <HBox fx:id="invoiceSummaryBar" spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="lblTotalOutstanding"
                                   style="-fx-background-color:#fee2e2;-fx-text-fill:#dc2626;-fx-padding:4 12;-fx-background-radius:6;-fx-font-weight:bold;"/>
                            <Label fx:id="lblTotalPaid"
                                   style="-fx-background-color:#dcfce7;-fx-text-fill:#16a34a;-fx-padding:4 12;-fx-background-radius:6;-fx-font-weight:bold;"/>
                            <Label fx:id="lblInvoiceCount"
                                   style="-fx-background-color:#e0e7ff;-fx-text-fill:#4338ca;-fx-padding:4 12;-fx-background-radius:6;-fx-font-weight:bold;"/>
                        </HBox>

                        <TableView fx:id="invoiceTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                            <placeholder><Label text="No invoices found."/></placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="invColStudent"     text="Student"       minWidth="170"/>
                                <TableColumn fx:id="invColDue"         text="Due Date"      maxWidth="110" minWidth="95"/>
                                <TableColumn fx:id="invColTotal"       text="Total (LKR)"   maxWidth="120" minWidth="100"/>
                                <TableColumn fx:id="invColDiscount"    text="Discount"      maxWidth="110" minWidth="90"/>
                                <TableColumn fx:id="invColPaid"        text="Paid (LKR)"    maxWidth="110" minWidth="90"/>
                                <TableColumn fx:id="invColOutstanding" text="Outstanding"   maxWidth="120" minWidth="100"/>
                                <TableColumn fx:id="invColStatus"      text="Status"        maxWidth="100" minWidth="85"/>
                                <TableColumn fx:id="invColActions"     text="Actions"       maxWidth="160" minWidth="140"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Bottom: payment history for selected invoice -->
                    <VBox spacing="10">
                        <padding><Insets top="10" right="16" bottom="14" left="16"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="paymentsTitle"
                                   text="Payments — select an invoice above"
                                   styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnRecordPayment"
                                    text="＋  Record Payment"
                                    styleClass="btn-primary"
                                    onAction="#handleRecordPayment"
                                    disable="true"/>
                        </HBox>
                        <TableView fx:id="paymentsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                            <placeholder><Label text="Select an invoice above to view payments."/></placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="pyColDate"    text="Date"         maxWidth="110" minWidth="95"/>
                                <TableColumn fx:id="pyColAmount"  text="Amount (LKR)" maxWidth="130" minWidth="110"/>
                                <TableColumn fx:id="pyColMethod"  text="Method"       maxWidth="130" minWidth="100"/>
                                <TableColumn fx:id="pyColReceipt" text="Receipt No."  minWidth="130"/>
                                <TableColumn fx:id="pyColActions" text="Actions"      maxWidth="110" minWidth="90"/>
                            </columns>
                        </TableView>
                    </VBox>

                </SplitPane>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
