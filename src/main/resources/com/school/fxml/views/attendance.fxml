<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
  attendance.fxml
  Path: src/main/resources/com/school/fxml/views/attendance.fxml
  Used by both Teacher (Mark Attendance) and Principal (Attendance overview).
-->
<BorderPane
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.school.controller.AttendanceController"
        stylesheets="@../../css/styles.css">

    <!-- ═══ TOP: title + filter bar ════════════════════════════ -->
    <top>
        <VBox>
            <!-- Title row -->
            <HBox alignment="CENTER_LEFT">
                <padding><Insets top="20" right="24" bottom="12" left="24"/></padding>
                <Label fx:id="pageTitle" text="Attendance" styleClass="page-title"/>
            </HBox>
            <Separator/>

            <!-- Filter bar -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>

                <Label text="Class:" styleClass="form-label"/>
                <ComboBox fx:id="classCombo" prefWidth="170" promptText="Select class…"/>

                <Label text="Date:" styleClass="form-label"/>
                <DatePicker fx:id="datePicker" prefWidth="145"/>

                <Label text="Period:" styleClass="form-label"/>
                <ComboBox fx:id="periodCombo" prefWidth="100" promptText="Period…"/>

                <Button text="Load"
                        styleClass="btn-secondary"
                        onAction="#handleLoad"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Summary badges — hidden until a period is loaded -->
                <HBox fx:id="summaryBar" spacing="10" alignment="CENTER_RIGHT" visible="false" managed="false">
                    <Label fx:id="lblPresent"  style="-fx-background-color:#dcfce7;-fx-text-fill:#16a34a;-fx-padding:4 10;-fx-background-radius:6;-fx-font-weight:bold;"/>
                    <Label fx:id="lblAbsent"   style="-fx-background-color:#fee2e2;-fx-text-fill:#dc2626;-fx-padding:4 10;-fx-background-radius:6;-fx-font-weight:bold;"/>
                    <Label fx:id="lblLate"     style="-fx-background-color:#ffedd5;-fx-text-fill:#ea580c;-fx-padding:4 10;-fx-background-radius:6;-fx-font-weight:bold;"/>
                    <Label fx:id="lblMedical"  style="-fx-background-color:#dbeafe;-fx-text-fill:#2563eb;-fx-padding:4 10;-fx-background-radius:6;-fx-font-weight:bold;"/>
                </HBox>
            </HBox>
            <Separator/>
        </VBox>
    </top>

    <!-- ═══ CENTER: marking table ══════════════════════════════ -->
    <center>
        <TableView fx:id="attendanceTable" styleClass="table-view">
            <placeholder>
                <Label text="Select a class, date, and period above then click Load."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colNum"    text="#"            minWidth="40" prefWidth="45"  maxWidth="60"/>
                <TableColumn fx:id="colName"   text="Student Name" minWidth="230" prefWidth="280"/>
                <TableColumn fx:id="colNameSi" text="නම (සිංහල)"  minWidth="230" prefWidth="280"/>
                <TableColumn fx:id="colStatus" text="Status"      minWidth="350" prefWidth="380" maxWidth="420"/>
            </columns>
        </TableView>
    </center>

    <!-- ═══ BOTTOM: submit bar ══════════════════════════════════ -->
    <bottom>
        <VBox>
            <Separator/>
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
                <Label fx:id="statusLabel" style="-fx-text-fill:#64748b;"/>
                <Button fx:id="btnSubmit"
                        text="Submit Attendance"
                        styleClass="btn-primary"
                        onAction="#handleSubmit"
                        disable="true"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>